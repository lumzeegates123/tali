{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tooling/typescript/*.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "prisma/**", "tsconfig.json", "tsconfig.build.json", "package.json", "prisma.config.ts"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "prisma/**", "tsconfig.json", "package.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "tsconfig.json", "package.json", "vitest.config.*"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["^build", "build"],
      "passThroughEnv": ["TEST_DATABASE_URL", "TEST_MIGRATION_DATABASE_URL", "PRISMA_HIDE_UPDATE_MESSAGE"],
      "cache": false
    }
  }
}
