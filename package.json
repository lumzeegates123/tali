{
  "name": "tali-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "11.28.0"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "node tooling/dependency-boundaries.mjs",
    "text-integrity": "node tooling/text-integrity/src/cli.mjs",
    "verify": "pnpm run text-integrity && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run boundaries && pnpm run test"
  },
  "devDependencies": {
    "@tali/eslint-config": "workspace:*",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "6.0.3"
  }
}
