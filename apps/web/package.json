{
  "name": "@tali/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test && playwright test --config playwright.cognito.config.ts",
    "e2e:cognito": "playwright test --config playwright.cognito.config.ts"
  },
  "dependencies": {
    "@tali/config": "workspace:*",
    "@tali/domain": "workspace:*",
    "@tali/shared": "workspace:*",
    "aws-amplify": "6.22.1",
    "next": "16.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tali/tsconfig": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
