// Business module (ADR-005 sections 5, 7, 9 and 19). `businesses.id` is the
// tenant key. Memberships are tenant-owned: business_id NOT NULL, UNIQUE
// (business_id, id) for composite references, and one row per user and
// business. Status, role, length and version CHECKs live in the migration SQL.

model Business {
  id              String   @id @db.Uuid
  name            String
  currencyCode    String   @map("currency_code") @db.VarChar(3)
  timeZone        String   @map("time_zone")
  status          String
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(3)

  currency  Currency @relation(fields: [currencyCode], references: [code], onDelete: Restrict, onUpdate: Restrict)
  createdBy User     @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  locations          BusinessLocation[]
  memberships        BusinessMembership[]
  auditRecords       BusinessAuditRecord[]
  idempotencyRecords BusinessIdempotencyRecord[]
  invitations        BusinessInvitation[]
  devices            Device[]

  productCategories    ProductCategory[]
  products             Product[]
  productVariants      ProductVariant[]
  productPacks         ProductPack[]
  productVariantPrices ProductVariantPrice[]
  pricedVariants       ProductVariant[]      @relation("VariantPriceCurrency")
  pricedHistory        ProductVariantPrice[] @relation("PriceHistoryCurrency")

  inventoryOpeningBatches InventoryOpeningBatch[]
  goodsReceipts           GoodsReceipt[]
  inventoryAdjustments    InventoryAdjustment[]
  inventoryMovements      InventoryMovement[]
  inventoryBalances       InventoryBalance[]
  inventoryThresholds     InventoryStockThreshold[]
  stocktakes              Stocktake[]
  stocktakeLines          StocktakeLine[]

  // Target of the catalog's composite currency foreign keys (ADR-008 section
  // 3.4): a stored price is always in its business's currency.
  @@unique([id, currencyCode])
  @@map("businesses")
}

model BusinessMembership {
  businessId String   @map("business_id") @db.Uuid
  id         String   @id @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String
  status     String
  version    Int
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  actedAuditRecords   BusinessAuditRecord[]
  createdInvitations  BusinessInvitation[]    @relation("InvitationCreatedBy")
  acceptedInvitations BusinessInvitation[]    @relation("InvitationAcceptedBy")
  revokedInvitations  BusinessInvitation[]    @relation("InvitationRevokedBy")
  registeredDevices   Device[]                @relation("DeviceRegisteredBy")
  revokedDevices      Device[]                @relation("DeviceRevokedBy")
  createdProducts     Product[]               @relation("ProductCreatedBy")
  setPrices           ProductVariantPrice[]   @relation("PriceSetBy")
  openingBatches      InventoryOpeningBatch[] @relation("OpeningBatchActor")
  goodsReceipts       GoodsReceipt[]          @relation("GoodsReceiptActor")
  reversedReceipts    GoodsReceipt[]          @relation("GoodsReceiptReversedBy")
  adjustments         InventoryAdjustment[]   @relation("InventoryAdjustmentActor")
  reversedAdjustments InventoryAdjustment[]   @relation("InventoryAdjustmentReversedBy")
  inventoryMovements  InventoryMovement[]     @relation("InventoryMovementActor")
  createdStocktakes   Stocktake[]             @relation("StocktakeCreatedBy")
  postedStocktakes    Stocktake[]             @relation("StocktakePostedBy")
  cancelledStocktakes Stocktake[]             @relation("StocktakeCancelledBy")
  countedLines        StocktakeLine[]         @relation("StocktakeLineCountedBy")

  @@unique([businessId, id])
  @@unique([businessId, userId])
  @@index([userId])
  @@map("business_memberships")
}

// Invitations (ADR-005 section 14). Only the 32-byte SHA-256 digest of the
// one-time token is stored; `token_hash` is globally unique so acceptance can
// find the row without a business. EXPIRED is derived from `expires_at`, never
// stored. Role, status, digest-length and timestamp CHECKs live in the
// migration SQL. Membership references are composite, so they stay in the
// invitation's business.
model BusinessInvitation {
  businessId             String    @map("business_id") @db.Uuid
  id                     String    @id @db.Uuid
  tokenHash              Bytes     @unique @map("token_hash")
  role                   String
  status                 String
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(3)
  createdByMembershipId  String    @map("created_by_membership_id") @db.Uuid
  createdAt              DateTime  @map("created_at") @db.Timestamptz(3)
  acceptedByMembershipId String?   @map("accepted_by_membership_id") @db.Uuid
  acceptedAt             DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedByMembershipId  String?   @map("revoked_by_membership_id") @db.Uuid
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(3)

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy  BusinessMembership  @relation("InvitationCreatedBy", fields: [businessId, createdByMembershipId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)
  acceptedBy BusinessMembership? @relation("InvitationAcceptedBy", fields: [businessId, acceptedByMembershipId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy  BusinessMembership? @relation("InvitationRevokedBy", fields: [businessId, revokedByMembershipId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([businessId, id])
  @@index([businessId, status])
  @@map("business_invitations")
}

// Devices (ADR-005 section 15). A registration belongs to one business; the
// same physical device registers separately per business. Only the 32-byte
// SHA-256 digest of the one-time credential is stored. There is no
// last_seen_at column (ADR-005 sections 15.1 and 15.4).
model Device {
  businessId               String    @map("business_id") @db.Uuid
  id                       String    @id @db.Uuid
  platform                 String
  label                    String
  credentialHash           Bytes     @map("credential_hash")
  status                   String
  registeredByMembershipId String    @map("registered_by_membership_id") @db.Uuid
  registeredAt             DateTime  @map("registered_at") @db.Timestamptz(3)
  revokedByMembershipId    String?   @map("revoked_by_membership_id") @db.Uuid
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(3)

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  registeredBy BusinessMembership  @relation("DeviceRegisteredBy", fields: [businessId, registeredByMembershipId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy    BusinessMembership? @relation("DeviceRevokedBy", fields: [businessId, revokedByMembershipId], references: [businessId, id], onDelete: Restrict, onUpdate: Restrict)

  auditRecords BusinessAuditRecord[]

  inventoryOpeningBatches InventoryOpeningBatch[]
  goodsReceipts           GoodsReceipt[]
  inventoryAdjustments    InventoryAdjustment[]
  inventoryMovements      InventoryMovement[]

  @@unique([businessId, id])
  @@index([businessId, status])
  @@map("devices")
}
