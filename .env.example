# Tali server configuration example (validated by @tali/config/server).
# Placeholders only. Never commit real values; copy to .env locally.

TALI_ENV=local

# Database (PostgreSQL; local Docker in Wave B)
DATABASE_URL=postgresql://tali:change-me@localhost:5432/tali

# Identity: cognito | local | fake (local/fake are rejected in deployed environments)
IDENTITY_PROVIDER=local
# Required only when IDENTITY_PROVIDER=cognito
# COGNITO_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_IDS=

# Object storage: s3 | local | memory (local/memory are rejected in deployed environments)
OBJECT_STORAGE_PROVIDER=local
LOCAL_OBJECT_STORAGE_DIR=.local/object-storage
# Required only when OBJECT_STORAGE_PROVIDER=s3
# S3_REGION=
# S3_BUCKET=
SIGNED_URL_TTL_SECONDS=300

# Queue: sqs | memory (memory is for tests and single-process smoke tests only)
QUEUE_PROVIDER=memory
# Required only when QUEUE_PROVIDER=sqs
# SQS_REGION=
# SQS_QUEUE_URL=

# API
API_PORT=3000
API_CORS_ORIGINS=http://localhost:3001

# Observability
LOG_LEVEL=info
SERVICE_NAME=tali-local

# Public client configuration (safe to expose; never put secrets here)
NEXT_PUBLIC_TALI_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_TALI_ENV=local
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
