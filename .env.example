# Tali server configuration example (validated by @tali/config/server).
# Placeholders only. Never commit real values; copy to .env locally.
# The database credentials below are the synthetic, local-only values from
# docker-compose.yml; they are not secrets and are never valid elsewhere.

TALI_ENV=local

# Database: runtime connection as the least-privileged application role (tali_app).
DATABASE_URL=postgresql://tali_app:local-only-app@127.0.0.1:55432/tali_local

# Prisma CLI only (packages/database). Owner/migration role; never given to the API or worker.
MIGRATION_DATABASE_URL=postgresql://tali_owner:local-only-owner@127.0.0.1:55432/tali_local
SHADOW_DATABASE_URL=postgresql://tali_owner:local-only-owner@127.0.0.1:55432/tali_local_shadow

# Identity: cognito | local | fake (local/fake are rejected in deployed environments).
# Wave B composes only `fake`; `local` (dev JWT) and `cognito` are not implemented yet.
IDENTITY_PROVIDER=fake
# Required only when IDENTITY_PROVIDER=cognito
# COGNITO_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_IDS=

# Object storage: s3 | local | memory (local/memory are rejected in deployed environments)
OBJECT_STORAGE_PROVIDER=local
LOCAL_OBJECT_STORAGE_DIR=.local/object-storage
# Required only when OBJECT_STORAGE_PROVIDER=s3
# S3_REGION=
# S3_BUCKET=
SIGNED_URL_TTL_SECONDS=300

# Queue: sqs | memory. memory is in-process only (tests and single-process smoke
# tests); it does not connect the API and worker processes.
QUEUE_PROVIDER=memory
# Required only when QUEUE_PROVIDER=sqs
# SQS_REGION=
# SQS_QUEUE_URL=

# API
API_PORT=3000
API_CORS_ORIGINS=http://localhost:3001

# Worker
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_FILE=.local/worker-heartbeat.json
WORKER_HEARTBEAT_INTERVAL_MS=5000
# local/test only: publish one harmless smoke message on start
WORKER_SMOKE_ON_START=false

# Process lifecycle
SHUTDOWN_GRACE_PERIOD_MS=10000

# Observability
LOG_LEVEL=info
SERVICE_NAME=tali-local

# Public client configuration (safe to expose; never put secrets here)
NEXT_PUBLIC_TALI_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_TALI_ENV=local
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
